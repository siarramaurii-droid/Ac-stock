<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>AC Stock</title>
<meta name="application-name" content="AC Stock">
<meta name="theme-color" content="#14171b">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="AC Stock">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="apple-touch-icon" sizes="180x180" href="/icons/ac-stock-180.png">
<link rel="manifest" href="/manifest.webmanifest">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#f5f6f8;--c:#fff;--t:#1b1f24;--m:#667;--b:#dde1e6;--a:#1f5fbf;--ok:#1a7f4b;--w:#b45309;--r:#b91c1c}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#14171b;--c:#1d2127;--t:#eceff3;--m:#9aa4b0;--b:#323943;--a:#6ea3f5;--ok:#4ade80;--w:#fbbf24;--r:#f87171}}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;background:var(--bg);color:var(--t);font:15px system-ui,-apple-system,Segoe UI,sans-serif}
header{padding:14px 16px;font-weight:700;font-size:18px;display:flex;justify-content:space-between;gap:10px;align-items:center}nav{display:flex;gap:6px;padding:0 12px 8px;overflow-x:auto}nav button{flex:1;min-width:max-content}main{padding:0 12px 40px;max-width:900px;margin:auto}
.card{background:var(--c);border:1px solid var(--b);border-radius:10px;padding:12px;margin-bottom:10px}
button{font:inherit;padding:9px 12px;border-radius:8px;border:1px solid var(--b);background:var(--c);color:var(--t);cursor:pointer}button.p,nav button.on{background:var(--a);color:#fff;border-color:var(--a)}button:disabled{opacity:.55}
input,select{font:inherit;padding:9px;border-radius:8px;border:1px solid var(--b);background:var(--bg);color:var(--t);width:100%;box-sizing:border-box}
label{display:block;font-size:12px;color:var(--m);margin:8px 0 3px}.row{display:flex;gap:8px;flex-wrap:wrap}.row>*{flex:1;min-width:130px}
.n{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;text-align:center;margin-top:8px}.n b{display:block;font-size:20px}.n span{font-size:11px;color:var(--m)}
.ok{color:var(--ok)}.w{color:var(--w)}.r{color:var(--r)}.m{color:var(--m);font-size:13px}.scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px}td,th{padding:6px;border-bottom:1px solid var(--b);text-align:left;white-space:nowrap}.hide{display:none}
.auth{max-width:420px;margin:8vh auto;padding:18px}.auth h2{margin-top:0}.auth button{width:100%;margin-top:12px}.top-actions{display:flex;gap:8px;align-items:center}.top-actions button{padding:6px 9px}.notice{padding:10px;border-radius:8px;background:var(--bg);margin:10px 0}
</style>
</head>
<body>
<header><span>📦 Control de stock <span id="who" class="m"></span></span><span class="top-actions" id="account"></span></header>
<nav id="nav" class="hide" aria-label="Secciones"></nav><main id="app"><p class="m">Iniciando…</p></main>
<script>
(async function boot(){
  const app=document.getElementById("app");
  app.innerHTML='<div class="card">Conectando con el servicio…</div>';
  const loadScript=(src)=>new Promise((resolve,reject)=>{
    const s=document.createElement("script");s.src=src;s.async=true;
    s.onload=()=>window.supabase?.createClient?resolve():reject(new Error("La biblioteca se descargó, pero no quedó disponible."));
    s.onerror=()=>reject(new Error("No se pudo descargar desde "+src));
    document.head.appendChild(s);
  });
  try{
    try{await loadScript("https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2");}
    catch(first){await loadScript("https://unpkg.com/@supabase/supabase-js@2");}
  }catch(e){
    app.innerHTML="";
    const card=document.createElement("div");card.className="card";
    const title=document.createElement("b");title.textContent="No se pudo iniciar la conexión.";
    const detail=document.createElement("p");detail.textContent=String(e?.message||e);
    const help=document.createElement("p");help.textContent="Comprobá que Safari tenga conexión a internet. Si abriste el archivo localmente, publicalo en una dirección web.";
    const retry=document.createElement("button");retry.type="button";retry.textContent="Volver a intentar";retry.addEventListener("click",()=>location.reload());
    card.append(title,detail,help,retry);app.append(card);return;
  }
  /* Configuración del proyecto Supabase */
  const SUPABASE_URL="https://xtidddynkdsirftvhiap.supabase.co";
  const SUPABASE_ANON_KEY="sb_publishable_0__u2Ey5oT0r3C211dIVwg_q1efbmsi";
  const client=window.supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY);

  const TABS=[["inv","Inventario"],["sal","Salida"],["eve","Salidas"],["his","Historial"]];
  let tab="inv",session=null,me="Usuario",role="consulta",mats=[],movs=[],err="",syncErr="",ready=false,P=null,busy=false,Q="";
  const $=s=>document.querySelector(s);
  const esc=s=>String(s??"").replace(/[&<>\"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
  const fmt=t=>t?new Date(t).toLocaleString("es-AR",{dateStyle:"short",timeStyle:"short"}):"—";
  const canWork=()=>role==="admin"||role==="encargado";
  const isAdmin=()=>role==="admin";
  const Z={disp:0,fuera:0,dan:0,rep:0,total:0};
  function stock(id){const s={...Z};movs.filter(m=>m.mat===id).forEach(m=>{for(const k in Z)s[k]+=Number((m.d&&m.d[k])||0)});return s}
  function salidas(){return movs.filter(m=>m.tipo==="salida").map(s=>{const r=movs.filter(m=>m.salida===s.id);const sum=k=>r.reduce((a,m)=>a+Number((m.q&&m.q[k])||0),0);const dev=sum("ok"),dan=sum("dan"),rep=sum("rep"),per=sum("per");return{...s,dev,dan,rep,per,pend:Number(s.cant)-dev-dan-rep-per}})}
  function showError(e){return e?.message||e?.details||e?.hint||String(e||"Error desconocido")}
  function nav(){$("#nav").innerHTML=TABS.map(([k,l])=>`<button type="button" data-tab="${k}" class="${tab===k?"on":""}" aria-current="${tab===k?"page":"false"}">${l}</button>`).join("")}
  function render(force=false){const active=document.activeElement;if(!force&&ready&&active&&/^(INPUT|SELECT)$/.test(active.tagName)&&$("#app").contains(active))return;if(!session){$("#nav").classList.add("hide");$("#account").innerHTML="";$("#who").textContent="";$("#app").innerHTML=loginView();return}$("#nav").classList.remove("hide");$("#who").textContent="· "+me+" · "+roleLabel(role);$("#account").innerHTML='<button type="button" data-action="logout">Salir</button>';nav();if(!ready){$("#app").innerHTML=`<p class="m">${esc(err||"Cargando inventario…")}</p>`;return}const syncNotice=syncErr?`<div class="notice r" role="alert">${esc(syncErr)}</div>`:"";$("#app").innerHTML=syncNotice+({inv:vInv,sal:vSal,eve:vEve,his:vHis})[tab]()}
  function roleLabel(r){return({admin:"Administrador",encargado:"Encargado",consulta:"Consulta"})[r]||r}
  function loginView(){return `<div class="card auth"><h2>Control de stock</h2><p class="m">Ingresá con el correo y la contraseña que te creó el administrador.</p>${err?`<p class="r" role="alert">${esc(err)}</p>`:""}<form id="loginForm"><label for="email">Correo electrónico</label><input id="email" type="email" autocomplete="username" placeholder="tu correo" required><label for="password">Contraseña</label><input id="password" type="password" autocomplete="current-password" placeholder="Tu contraseña" required><p id="loginerr" class="r" role="alert"></p><button class="p" type="submit">Ingresar</button></form></div>`}
  async function login(){const email=$("#email")?.value.trim(),password=$("#password")?.value,loginerr=$("#loginerr");if(!email||!password){if(loginerr)loginerr.textContent="Completá correo y contraseña.";return}if(loginerr)loginerr.textContent="";try{const{data,error}=await client.auth.signInWithPassword({email,password});if(error)throw error;if(!data?.session)throw new Error("El inicio de sesión no devolvió una sesión válida.");session=data.session;await startApp()}catch(e){if(loginerr)loginerr.textContent=showError(e);else{err="No se pudo iniciar sesión: "+showError(e);render(true)}}}
  async function logout(){try{const{error}=await client.auth.signOut();if(error)throw error;session=null;ready=false;mats=[];movs=[];P=null;err="";syncErr="";render(true)}catch(e){syncErr="No se pudo cerrar la sesión: "+showError(e);render(true)}}
  async function loadProfile(){const{data,error}=await client.from("profiles").select("id,role").eq("id",session.user.id).single();if(error)throw error;role=data?.role||"consulta";me=session.user.email||"Usuario"}
  async function refreshData(force=false){const[a,b]=await Promise.all([client.from("mats").select("*"),client.from("movs").select("*").order("ts",{ascending:true})]);if(a.error)throw a.error;if(b.error)throw b.error;mats=a.data||[];movs=(b.data||[]).map(m=>({...m,fSalida:m.fsalida??m.fSalida,fPrevista:m.fprevista??m.fPrevista,user:m.user_name??m.user??""}));ready=true;err="";syncErr="";render(force)}
  async function startApp(){ready=false;err="";syncErr="";render(true);try{await loadProfile();await refreshData(true)}catch(e){err="No se pudo cargar la cuenta o el inventario: "+showError(e);ready=false;render(true)}}
  async function add(m){const row={...m,user_id:session.user.id,user_name:me};delete row.user;const{error}=await client.from("movs").insert(row);if(error)throw error;await refreshData(true)}
  async function addMat(){err="";const n=$("#mn").value.trim(),q=parseInt($("#mq").value,10);if(!n||!(q>0)){err="Ingresá nombre y una cantidad mayor a 0.";return render(true)}if(mats.some(m=>String(m.nombre).toLowerCase()===n.toLowerCase())){err="Ese material ya existe.";return render(true)}try{const{data,error}=await client.from("mats").insert({nombre:n,ts:Date.now()}).select("id").single();if(error)throw error;await add({mat:data.id,tipo:"ingreso",cant:q,d:{total:q,disp:q}})}catch(e){err="No se pudo guardar: "+showError(e)}render(true)}
  function vInv(){return pnl("ing")+pnl("aj")+(canWork()?`<div class="card"><b>Agregar material</b><div class="row"><div><label for="mn">Nombre</label><input id="mn"></div><div><label for="mq">Cantidad inicial</label><input id="mq" type="number" min="1"></div></div><p><button type="button" class="p" data-action="addMat">Guardar</button> <span class="r" role="alert">${esc(err)}</span></p></div>`:"")+(mats.length?mats.map(m=>{const s=stock(m.id);return `<div class="card"><b>${esc(m.nombre)}</b><div class="n"><div><b>${s.total}</b><span>Stock total</span></div><div><b class="ok">${s.disp}</b><span>Disponibles</span></div><div><b class="w">${s.fuera}</b><span>Fuera del depósito</span></div></div>${s.dan||s.rep?`<p class="m">Dañados: ${s.dan} · En reparación: ${s.rep}</p>`:""}${canWork()?`<p><button type="button" class="p" data-action="openP" data-panel="ing" data-id="${esc(m.id)}">+ Agregar stock</button> ${isAdmin()?`<button type="button" data-action="openP" data-panel="aj" data-id="${esc(m.id)}">⚖ Ajustar inventario</button>`:""}</p>`:""}</div>`}).join(""):`<p class="m">El inventario está vacío. ${canWork()?"Agregá tu primer material.":"Todavía no hay materiales cargados."}</p>`)}
  const nowL=()=>{const d=new Date();d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,16)};
  function openP(t,id){if(!canWork()||(t==="aj"&&!isAdmin())||!["ing","aj","dev"].includes(t))return;P={t,id};err="";render(true)}function closeP(){P=null;render(true)}function done(){P=null;busy=false;render(true)}function perr(m){const e=$("#pe");if(e)e.textContent=m}
  function pnl(ts){if(!P||!ts.includes(P.t))return"";const m=mats.find(x=>x.id===P.id)||{},s=stock(P.id),B='<span id="pe" class="r" role="alert"></span>',X='<button type="button" data-action="closeP">Cancelar</button>';
    if(P.t==="ing")return `<div class="card" style="border-color:var(--ok)"><b>Agregar stock — ${esc(m.nombre)}</b><p class="m">Stock total actual: ${s.total}</p><div class="row"><div><label for="ic">Cantidad incorporada</label><input id="ic" type="number" min="1"></div><div><label for="ifh">Fecha y hora</label><input id="ifh" type="datetime-local" value="${nowL()}"></div></div><div class="row"><div><label for="im">Motivo</label><input id="im" value="Compra"></div><div><label for="ip">Proveedor (opcional)</label><input id="ip"></div></div><label for="io">Observaciones</label><input id="io"><p><button type="button" class="p" data-action="doIng">Confirmar ingreso</button> ${X} ${B}</p></div>`;
    if(P.t==="aj")return `<div class="card" style="border-color:var(--w)"><b>Ajustar inventario — ${esc(m.nombre)}</b><p class="m">Registrado: total ${s.total} · disponibles ${s.disp} · fuera ${s.fuera}.</p><div class="row"><div><label for="ar">Cantidad real (stock total)</label><input id="ar" type="number" min="0"></div><div><label for="am">Motivo del ajuste</label><input id="am" value="Recuento físico"></div></div><p><button type="button" class="p" data-action="doAj">Confirmar ajuste</button> ${X} ${B}</p></div>`;
    if(P.t==="dev"){const q=salidas().find(x=>x.id===P.id);if(!q)return"";const material=mats.find(x=>x.id===q.mat)||{},n=(i,l,v)=>`<div><label for="${i}">${l}</label><input id="${i}" type="number" min="0" value="${v}"></div>`;return `<div class="card" style="border-color:var(--ok)"><b>Devolución — ${esc(material.nombre)} · ${esc(q.evento)}</b><p class="m">Salieron ${q.cant} · Pendientes de devolver: ${q.pend}</p><div class="row">${n("dok","En buen estado",q.pend)}${n("ddn","Dañadas",0)}</div><div class="row">${n("drp","En reparación",0)}${n("dpr","Perdidas",0)}</div><div class="row"><div><label for="dfh">Fecha y hora de devolución</label><input id="dfh" type="datetime-local" value="${nowL()}"></div><div><label for="drc">Recibió</label><input id="drc" value="${esc(me)}"></div></div><label for="dob">Observaciones</label><input id="dob"><p><button type="button" class="p" data-action="doDev">Confirmar devolución</button> ${X} ${B}</p></div>`}return""}
  async function doIng(){if(busy)return;const v=i=>$("#"+i).value.trim(),q=parseInt(v("ic"),10),s=stock(P.id);if(!(q>0))return perr("Ingresá una cantidad mayor a 0.");if(!v("ifh")||!v("im"))return perr("Completá fecha y motivo.");busy=true;try{await add({mat:P.id,tipo:"compra",cant:q,ts:new Date(v("ifh")).getTime(),motivo:v("im"),proveedor:v("ip"),obs:v("io"),ant:s.total,nuevo:s.total+q,d:{total:q,disp:q}})}catch(e){busy=false;return perr("No se pudo guardar: "+showError(e))}done()}
  async function doAj(){if(busy||!isAdmin()||P?.t!=="aj")return;const v=i=>$("#"+i)?.value.trim()||"",raw=v("ar"),r=Number(raw),s=stock(P.id);if(raw===""||!Number.isInteger(r)||r<0)return perr("Ingresá una cantidad entera de 0 o más.");const motivo=v("am");if(!motivo)return perr("Indicá el motivo.");const df=r-s.total;if(df===0)return perr("La cantidad real coincide con el stock registrado.");if(s.disp+df<0)return perr("Dejaría disponibles en negativo; hay "+s.fuera+" unidades fuera del depósito.");busy=true;try{await add({mat:P.id,tipo:"ajuste",cant:df,ts:Date.now(),motivo,ant:s.total,nuevo:r,d:{total:df,disp:df}})}catch(e){busy=false;return perr("No se pudo guardar: "+showError(e))}done()}
  async function doDev(){if(busy)return;const s=salidas().find(x=>x.id===P.id);if(!s)return;const g=i=>parseInt($("#"+i).value,10)||0,ok=g("dok"),dan=g("ddn"),rep=g("drp"),per=g("dpr"),t=ok+dan+rep+per,f=$("#dfh").value,rc=$("#drc").value.trim();if([ok,dan,rep,per].some(x=>x<0)||t<=0)return perr("Ingresá al menos una unidad (sin negativos).");if(t>s.pend)return perr("No podés devolver más de lo pendiente ("+s.pend+").");if(!f||!rc)return perr("Indicá fecha/hora y quién recibió.");busy=true;try{await add({mat:s.mat,tipo:"devolucion",salida:s.id,evento:s.evento,cant:t,ts:new Date(f).getTime(),recibio:rc,obs:$("#dob").value.trim(),q:{ok,dan,rep,per},d:{disp:ok,fuera:-t,dan:dan,rep:rep,total:-per}})}catch(e){busy=false;return perr("No se pudo guardar: "+showError(e))}done()}
  function vSal(){if(!canWork())return'<p class="m">Tu usuario tiene permiso de solo lectura.</p>';if(!mats.length)return'<p class="m">Primero cargá materiales.</p>';return `<div class="card"><b>Registrar salida</b><label for="sm">Material</label><select id="sm">${mats.map(m=>`<option value="${esc(m.id)}">${esc(m.nombre)} (disp. ${stock(m.id).disp})</option>`).join("")}</select><div class="row"><div><label for="sc">Cantidad</label><input id="sc" type="number" min="1"></div><div><label for="sr">Responsable</label><input id="sr"></div></div><label for="se">Evento</label><input id="se"><label for="sl">Lugar</label><input id="sl"><div class="row"><div><label for="sf">Fecha y hora de salida</label><input id="sf" type="datetime-local" value="${nowL()}"></div><div><label for="sd">Devolución prevista</label><input id="sd" type="datetime-local"></div></div><p><button type="button" class="p" data-action="doSal">Confirmar salida</button> <span class="r" role="alert">${esc(err)}</span></p></div>`}
  async function doSal(){err="";if(!canWork())return;const g=i=>$("#"+i).value.trim(),mat=g("sm"),q=parseInt(g("sc"),10);if(!(q>0)||!g("se")||!g("sl")||!g("sf")||!g("sd")||!g("sr")){err="Completá todos los campos.";return render(true)}if(q>stock(mat).disp){err="No hay suficientes disponibles ("+stock(mat).disp+").";return render(true)}try{await add({mat,tipo:"salida",cant:q,evento:g("se"),lugar:g("sl"),fsalida:new Date(g("sf")).getTime(),fprevista:new Date(g("sd")).getTime(),resp:g("sr"),d:{disp:-q,fuera:q}});tab="eve";render(true)}catch(e){err="No se pudo guardar: "+showError(e);render(true)}}
  function salidaCard(s){const m=mats.find(x=>x.id===s.mat),late=s.pend>0&&s.fPrevista<Date.now();return `<div class="card"><b>${esc(m?.nombre)}</b> — ${s.cant} u. · <b>${esc(s.evento)}</b><br><span class="m">📍 ${esc(s.lugar)} · 👤 ${esc(s.resp)}<br>Salió: ${fmt(s.fSalida)} · Prevista: <span class="${late?"r":""}">${fmt(s.fPrevista)}${late?" (vencida)":""}</span></span><p>Devueltas: ${s.dev} · Dañadas: ${s.dan} · En reparación: ${s.rep} · Perdidas: ${s.per} · <b class="${s.pend>0?"w":"ok"}">Faltan: ${s.pend}</b></p>${s.pend>0&&canWork()?`<button type="button" class="p" data-action="openP" data-panel="dev" data-id="${esc(s.id)}">Registrar devolución</button>`:""}</div>`}
  function salidasListado(){const q=Q.toLowerCase(),f=salidas().filter(s=>!q||(s.evento+" "+s.lugar+" "+(mats.find(x=>x.id===s.mat)?.nombre||"")).toLowerCase().includes(q)).sort((a,b)=>b.ts-a.ts);const grp=l=>{const g={};l.forEach(s=>(g[s.evento]=g[s.evento]||[]).push(s));return Object.keys(g).map(e=>`<h4 style="margin:10px 0 6px">${esc(e)}</h4>`+g[e].map(salidaCard).join("")).join("")};const p=f.filter(s=>s.pend>0),a=f.filter(s=>s.pend<=0);return `<h3>Pendientes (${p.length})</h3>${grp(p)||'<p class="m">Nada pendiente.</p>'}<h3>Anteriores</h3>${grp(a)||'<p class="m">Sin salidas cerradas.</p>'}`}
  function vEve(){return pnl("dev")+`<input aria-label="Buscar evento, lugar o material" placeholder="Buscar evento, lugar o material…" value="${esc(Q)}" data-search="events" style="margin-bottom:8px"><div id="el">${salidasListado()}</div>`}
  function vHis(){const L={ingreso:"Carga inicial",compra:"Ingreso de mercadería",ajuste:"Ajuste de inventario",salida:"Salida",devolucion:"Devolución"};return `<div class="card scroll"><table><tr><th>Fecha</th><th>Material</th><th>Tipo</th><th>Cant.</th><th>Evento</th><th>Usuario</th></tr>${[...movs].sort((a,b)=>b.ts-a.ts).map(m=>`<tr><td>${fmt(m.ts)}</td><td>${esc(mats.find(x=>x.id===m.mat)?.nombre)}</td><td>${L[m.tipo]||esc(m.tipo)}${m.nuevo!=null?` <span class="m">(${esc(m.ant)} → ${esc(m.nuevo)})</span>`:""}${m.q?` <span class="m">(ok ${esc(m.q.ok)}, dañ ${esc(m.q.dan)}, rep ${esc(m.q.rep)}, perd ${esc(m.q.per)})</span>`:""}</td><td>${esc(m.cant)}</td><td>${esc(m.evento||m.motivo||"")}${m.proveedor?` <span class="m">· ${esc(m.proveedor)}</span>`:""}${m.obs?` <span class="m">· ${esc(m.obs)}</span>`:""}</td><td>${esc(m.user_name||m.user||"")}${m.recibio?` <span class="m">(recibió ${esc(m.recibio)})</span>`:""}</td></tr>`).join("")}</table></div>`}

  document.addEventListener("submit",event=>{if(event.target?.id==="loginForm"){event.preventDefault();void login()}});
  document.addEventListener("click",event=>{const node=event.target instanceof Element?event.target.closest("[data-tab],[data-action]"):null;if(!node)return;if(node.dataset.tab){tab=node.dataset.tab;P=null;err="";render(true);return}switch(node.dataset.action){case"logout":void logout();break;case"addMat":if(canWork())void addMat();break;case"openP":openP(node.dataset.panel,node.dataset.id);break;case"closeP":closeP();break;case"doIng":if(canWork()&&P?.t==="ing")void doIng();break;case"doAj":if(isAdmin()&&P?.t==="aj")void doAj();break;case"doDev":if(canWork()&&P?.t==="dev")void doDev();break;case"doSal":if(canWork())void doSal();break}});
  document.addEventListener("input",event=>{const input=event.target;if(!(input instanceof HTMLInputElement)||input.dataset.search!=="events")return;Q=input.value;const list=$("#el");if(list)list.innerHTML=salidasListado()});
  try{const{data,error}=await client.auth.getSession();if(error)throw error;session=data.session;if(session)await startApp();else render(true)}catch(e){err="No se pudo comprobar la sesión: "+showError(e);render(true)}
  client.auth.onAuthStateChange((_event,s)=>{if(s?.user&&!session){session=s;void startApp()}else if(!s?.user&&session){session=null;ready=false;P=null;render(true)}});
  // Sincronización periódica para que los cambios de otros usuarios aparezcan también en iPhone/PC.
  setInterval(async()=>{if(session&&ready&&!document.hidden){try{await refreshData()}catch(e){syncErr="Error de sincronización: "+showError(e);const notice=$("#app .notice");if(notice)notice.textContent=syncErr;else render()}}},7000);
})();
</script>
</body>
</html>
